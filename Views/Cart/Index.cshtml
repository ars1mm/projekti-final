@model List<Projekti_Final.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart - Edin Store";
    ViewData["BodyClass"] = "auth-page";
}

<section class="auth-section">
    <div class="container px-4 px-lg-5">

        <div class="mb-5">
            <h1 class="h2 mb-2">Your Cart</h1>
            <p class="text-muted">Review your items before placing an order</p>
            <hr class="divider" />
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="card shadow-lg border-0 rounded">
                <div class="card-body p-5 text-center">
                    <i class="bi bi-cart-x fs-1 text-muted mb-3 d-block"></i>
                    <h4 class="text-muted mb-3">Your cart is empty</h4>
                    <p class="text-muted mb-4">Browse our products and add items to get started.</p>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-bag me-2"></i>Browse Products
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row gx-4 gx-lg-5">

                <!-- Cart Items -->
                <div class="col-lg-8 mb-4">
                    <div class="card shadow-lg border-0 rounded">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 text-dark">
                                <i class="bi bi-cart3 me-2"></i>Cart Items
                                <span class="badge bg-secondary ms-2">@Model.Sum(i => i.Quantity)</span>
                            </h5>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Product</th>
                                            <th class="text-center">Unit Price</th>
                                            <th class="text-center">Qty</th>
                                            <th class="text-center">Subtotal</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@item.Name</div>
                                                </td>
                                                <td class="text-center text-muted">@item.Price.ToString("C")</td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary px-3 py-2">@item.Quantity</span>
                                                </td>
                                                <td class="text-center fw-bold text-success">@item.Total.ToString("C")</td>
                                                <td class="text-end">
                                                    <form asp-action="Remove" asp-controller="Cart" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove item">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="col-lg-4 mb-4">
                    <div class="card shadow-lg border-0 rounded">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 text-dark">
                                <i class="bi bi-receipt me-2"></i>Order Summary
                            </h5>
                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Items (@Model.Sum(i => i.Quantity))</span>
                                <span>@ViewBag.Total.ToString("C")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Shipping</span>
                                <span class="text-success">Free</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                                <span>Total</span>
                                <span class="text-success">@ViewBag.Total.ToString("C")</span>
                            </div>
                            <div class="d-grid gap-2">
                                <a asp-action="Checkout" asp-controller="Cart" class="btn btn-primary btn-lg">
                                    <i class="bi bi-bag-check me-2"></i>Proceed to Checkout
                                </a>
                                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

    </div>
</section>
