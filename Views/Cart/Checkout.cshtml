@using Projekti_Final.Controllers
@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout - Edin Store";
    ViewData["BodyClass"] = "auth-page";
    var items = ViewBag.Items as List<Projekti_Final.Models.CartItem> ?? new List<Projekti_Final.Models.CartItem>();
}

<section class="auth-section">
    <div class="container px-4 px-lg-5">

        <div class="mb-5">
            <h1 class="h2 mb-2">Checkout</h1>
            <p class="text-muted">Complete your order by filling in your details below</p>
            <hr class="divider" />
        </div>

        <!-- Progress indicator -->
        <div class="d-flex align-items-center mb-5 checkout-steps">
            <div class="checkout-step completed">
                <span class="step-circle"><i class="bi bi-cart-check"></i></span>
                <span class="step-label">Cart</span>
            </div>
            <div class="checkout-connector"></div>
            <div class="checkout-step active">
                <span class="step-circle">2</span>
                <span class="step-label">Details</span>
            </div>
            <div class="checkout-connector"></div>
            <div class="checkout-step">
                <span class="step-circle">3</span>
                <span class="step-label">Confirmation</span>
            </div>
        </div>

        <form asp-action="Checkout" asp-controller="Cart" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 small" role="alert"></div>

            <div class="row gx-4 gx-lg-5">

                <!-- Left: Shipping + Payment -->
                <div class="col-lg-8">

                    <!-- Shipping Details -->
                    <div class="card shadow-lg border-0 rounded mb-4">
                        <div class="card-body p-5">
                            <h5 class="fw-bold mb-4 text-dark">
                                <i class="bi bi-geo-alt me-2"></i>Shipping Details
                            </h5>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label asp-for="FirstName" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="FirstName" class="form-control form-control-lg" placeholder="John" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="LastName" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="LastName" class="form-control form-control-lg" placeholder="Doe" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" class="form-control" placeholder="john@example.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="Phone" class="form-label fw-semibold text-dark"></label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                        <input asp-for="Phone" class="form-control" placeholder="+1 555 000 0000" />
                                    </div>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="AddressLine" class="form-label fw-semibold text-dark"></label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text"><i class="bi bi-house"></i></span>
                                        <input asp-for="AddressLine" class="form-control" placeholder="123 Main Street, Apt 4B" />
                                    </div>
                                    <span asp-validation-for="AddressLine" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-4">
                                    <label asp-for="City" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="City" class="form-control form-control-lg" placeholder="New York" />
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-4">
                                    <label asp-for="PostalCode" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="PostalCode" class="form-control form-control-lg" placeholder="10001" />
                                    <span asp-validation-for="PostalCode" class="text-danger small"></span>
                                </div>
                                <div class="col-sm-4">
                                    <label asp-for="Country" class="form-label fw-semibold text-dark"></label>
                                    <input asp-for="Country" class="form-control form-control-lg" placeholder="United States" />
                                    <span asp-validation-for="Country" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="card shadow-lg border-0 rounded mb-4">
                        <div class="card-body p-5">
                            <h5 class="fw-bold mb-4 text-dark">
                                <i class="bi bi-credit-card me-2"></i>Payment Method
                            </h5>

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="payment-option">
                                        <input class="form-check-input" type="radio" name="PaymentMethod"
                                               id="cod" value="Cash on Delivery" checked />
                                        <label class="payment-label" for="cod">
                                            <i class="bi bi-cash-coin me-2 text-success fs-5"></i>
                                            <div>
                                                <div class="fw-semibold">Cash on Delivery</div>
                                                <div class="text-muted small">Pay when your order arrives</div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="payment-option">
                                        <input class="form-check-input" type="radio" name="PaymentMethod"
                                               id="card" value="Credit / Debit Card" />
                                        <label class="payment-label" for="card">
                                            <i class="bi bi-credit-card me-2 text-primary fs-5"></i>
                                            <div>
                                                <div class="fw-semibold">Credit / Debit Card</div>
                                                <div class="text-muted small">Visa, Mastercard, American Express</div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="payment-option">
                                        <input class="form-check-input" type="radio" name="PaymentMethod"
                                               id="paypal" value="PayPal" />
                                        <label class="payment-label" for="paypal">
                                            <i class="bi bi-paypal me-2 text-info fs-5"></i>
                                            <div>
                                                <div class="fw-semibold">PayPal</div>
                                                <div class="text-muted small">Pay securely via PayPal</div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Right: Order Summary -->
                <div class="col-lg-4">
                    <div class="card shadow-lg border-0 rounded mb-4 sticky-top" style="top: 6rem;">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 text-dark">
                                <i class="bi bi-receipt me-2"></i>Order Summary
                            </h5>

                            @foreach (var item in items)
                            {
                                <div class="d-flex justify-content-between mb-2 small">
                                    <span class="text-muted">@item.Name <span class="badge bg-light text-dark">x@item.Quantity</span></span>
                                    <span class="fw-semibold">@item.Total.ToString("C")</span>
                                </div>
                            }
                            <hr />
                            <div class="d-flex justify-content-between mb-2 text-muted small">
                                <span>Shipping</span>
                                <span class="text-success">Free</span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                                <span>Total</span>
                                <span class="text-success">@ViewBag.Total.ToString("C")</span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-bag-check me-2"></i>Place Order
                                </button>
                                <a asp-action="Index" asp-controller="Cart" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>Back to Cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </form>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
